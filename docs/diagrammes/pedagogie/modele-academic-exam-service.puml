  SESSION_SEMESTRIELLE
  SESSION_RATTRAPAGE
  RESESSION_ANNUELLE
  EXAMEN_BLANC
  SESSION_EXTRAORDINAIRE
}
enum StatutSession {
  BROUILLON
  PROGRAMMEE
  EN_COURS
  CORRECTION
  DELIBERATION
  CLOTUREE
  ANNULEE
}
enum TypeEpreuve {
  ECRIT
  ORAL
  QCM
  PRATIQUE
  TP_NOTE
  DISSERTATION
  PROBLEME
  MIXTE
}
enum StatutEpreuve {
  PROJETEE
  VALIDEE
  PROGRAMMEE
  TENUE
  ANNULEE
}
