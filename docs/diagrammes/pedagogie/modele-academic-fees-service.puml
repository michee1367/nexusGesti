@startuml modele-academic-fees-service
title Diagramme de Classes - Service Frais de Scolarite et Paiements (academic-fees-service)
skinparam classAttributeIconSize 0
hide empty members

' ============================================================
' ENUMS
' ============================================================

enum TypeFrais {
  INSCRIPTION
  SCOLARITE
  CANTINE
  TRANSPORT
  FOURNITURES
  EXAMEN
  TENUE
  GARDERIE
  EXCURSION
  LABORATOIRE
  BIBLIOTHEQUE
  DIPLOME
  RATTRAPAGE
  AUTRE
}
enum CategorieFrais {
  OBLIGATOIRE
  OPTIONNEL
  FACULTATIF
  SANCTION
}
enum StatutGrille {
  BROUILLON
  ACTIVE
  ARCHIVEE
}
enum StatutAvis {
  BROUILLON
  EMIS
  PARTIELLEMENT_REGLE
  REGLE
  ANNULE
  EN_RETARD
  TRANSFERE
}
enum StatutEcheance {
  A_VENIR
  ECHUE
  REGLEE
  PARTIELLEMENT_REGLEE
  ANNULEE
  REPORTEE
}
enum MoyenPaiement {
  ESPECES
  MOBILE_MONEY
  VIREMENT
  CHEQUE
  CARTE
  PRELEVEMENT
  COMPENSATION
  DEVIS_ELEVE
}
enum StatutPaiement {
  EN_ATTENTE
  VALIDE
  REJETE
  ANNULE
  REMBOURSE
  A_VERIFIER
}
enum TypeBeneficiaire {
  ELEVE
  TIERS_PAYEUR
  EMPLOYEUR
  ANCIENNE
  AUTRE
}
enum StatutCoupon {
  A_TIRER
  TIRE
  REMIS
  ARCHIVE
  ANNULE
}

' ============================================================
' AGREGAT : GRILLE TARIFAIRE
' ============================================================

class GrilleTarifaire {
  - id : UUID
  - code : String
  - libelle : String
  - annee : UUID
  - profil : String
  - statut : StatutGrille
  - devise : String
  - dateActivation : Date
  - active : Boolean
  - version : Integer
  + activer() : GrilleTarifaire
  + figer() : GrilleTarifaire
  + archiver() : GrilleTarifaire
  + getCoutTotal(niveau : String, categorie : String) : Decimal
  + getLignes(niveau : String) : List<LigneGrille>
}

class LigneGrille {
  - id : UUID
  - grille : GrilleTarifaire
  - typeFrais : TypeFrais
  - categorie : CategorieFrais
  - libelle : String
  - montant : Decimal
  - montantPromo : Decimal?
  - devise : String
  - obligatoire : Boolean
  - periodicite : Periodicite
  - jour : Integer?
  - nbEcheances : Integer?
  - ordre : Integer
  + estOptionnel() : Boolean
  + estPeriodicite() : Boolean
}

enum Periodicite {
  PONCTUELLE
  MENSUELLE
  TRIMESTRIELLE
  SEMESTRIELLE
  ANNUELLE
}

class Reduction {
  - id : UUID
  - grille : GrilleTarifaire
  - code : String
  - libelle : String
  - type : TypeReduction
  - valeur : Decimal
  - cumulable : Boolean
  - conditions : List<ConditionReduction>
  + appliquer(montantBrut : Decimal, contexte : ContexteReduction) : Decimal
}

enum TypeReduction {
  POURCENTAGE
  MONTANT_FIXE
  TRANCHE
  TARIF_REDUIT
}

class ConditionReduction {
  - critere : String
  - operateur : String
  - valeur : String
  - cumulable : Boolean
}

class ContexteReduction {
  - niveau : String?
  - classe : UUID?
  - nombreEnfantsScolaires : Integer?
  - statutSocial : String?
  - bourse : Boolean
  - inscriptionTardive : Boolean
  - eleveRedoublant : Boolean
}

' ============================================================
' AGREGAT : AVIS DE PAIEMENT
' ============================================================

class AvisPaiement {
  - idAvis : UUID
  - reference : String
  - eleve : UUID
  - annee : UUID
  - classe : UUID
  - grille : GrilleTarifaire
  - dateEmission : Date
  - dateEcheanceGlobale : Date
  - statut : StatutAvis
  - montantBrut : Decimal
  - montantReduction : Decimal
  - montantNet : Decimal
  - montantRegle : Decimal
  - soldeDu : Decimal
  - devise : String
  - tauxChange : Decimal
  - journalier : UUID
  - ecritureGeneree : UUID
  + valider() : AvisPaiement
  + emettre() : AvisPaiement
  + recalculerSolde() : AvisPaiement
  + estSolde() : Boolean
  + estEnRetard(date : Date) : Boolean
  + annuler(motif : String) : AvisPaiement
  + getJoursRetard(date : Date) : Integer
  + appliquerRemise(reduction : UUID) : AvisPaiement
