class LigneFrais {
  - id : UUID
  - avis : UUID
  - typeFrais : TypeFrais
  - libelle : String
  - montantBrut : Decimal
  - tauxReduction : Decimal?
  - montantReduction : Decimal
  - montantNet : Decimal
  - nbEcheances : Integer
