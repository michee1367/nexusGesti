@startuml modele-academic-assessment-service
title Diagramme de Classes - Service Evaluation, Moyennes et Bulletins (academic-assessment-service)
skinparam classAttributeIconSize 0
hide empty members

' ============================================================
' ENUMS
' ============================================================

enum TypeEvaluation {
  INTERROGATION
  TP
  TD
  PROJET
  DEVOIR
  COMPOSITION
  ORAL
  EXAMEN_BLANC
  CONCOURS
  DEVOIR_SURVEILLE
}
enum StatutEvaluation {
  BROUILLON
  PLANIFIEE
  OUVERTE
  CLOTUREE
  PUBLIEE
  ANNULEE
}
enum StatutNote {
  PROVISOIRE
  DEFINITIVE
  CONTESTEE
  ANNULEE
  EXCLUE
}
enum TypeSourceNote {
  EVALUATION_CONTINUE
  SESSION_EXAMEN
  RATTRAPAGE
  CONTROLE_CONTINU
  EXCEPTION
}
enum TypeBareme {
  POINTS
  SUR_5
  SUR_10
  SUR_20
  SUR_100
  LETTRE
  MENTION
}
enum NiveauAcalcul {
  EVALUATION
  COURS_ECUE
  UE
  PERIODE
  ANNEE
  CYCLE
}
enum StrategieAggregation {
  MOYENNE_PONDEREE
  MOYENNE_NON_PONDEREE
  SOMME_PONDEREE
  MEILLEURE_NOTE
  MOYENNE_TRONQUEE
  DERNIERE_NOTE
}
enum StatutBulletin {
  BROUILLON
  CALCULE
  PUBLIE
  GENERE
  SIGNE
  RECTIFIE
  ANNULE
}
enum TypeBulletin {
  TRIMESTRIEL
  SEMESTRIEL
  ANNUEL
  PROVISOIRE
  RATTRAPAGE
  CERTIFICAT
}
enum StatutCoupon {
  A_TIRER
  TIRE
  DETACHE
  SIGNE_PAR_TUTEUR
  RENDU
  NON_RENDU
  PERDU
  INVALIDE
}

' ============================================================
' AGREGAT : EVALUATION
' ============================================================

class Evaluation {
  - idEvaluation : UUID
  - reference : String
  - libelle : String
  - type : TypeEvaluation
  - classe : UUID
  - cours : UUID
  - matsiere : UUID
  - enseignant : UUID
  - annee : UUID
  - periode : UUID
  - date : Date
  - heureDebut : Time?
  - duree : Integer?
  - salle : UUID
  - statut : StatutEvaluation
  - grille : GrilleNotation
  - bareme : Bareme
  - coefficientDeclare : Decimal?
  - consignes : String?
  - anonymise : Boolean
  - compteeDansMoyenne : Boolean
  - declencheSession : Boolean
  + ouvrir() : Evaluation
  + genererFeuille() : FeuilleNote
  + saisirNote(eleve : UUID, valeur : Decimal) : Evaluation
  + marquerAbsent(eleve : UUID) : Evaluation
  + cloturer() : Evaluation
  + publier() : Evaluation
  + annuler(motif : String) : Evaluation
  + estClosePourSaisie() : Boolean
  + getMaxNoteAtteignable() : Decimal
}

class FeuilleNote {
  - id : UUID
  - evaluation : UUID
  - statut : StatutBulletin
  - nbNotesAttendues : Integer
  - nbNotesSaisies : Integer
  - nbAbsents : Integer
  - ouverteLe : Instant?
  - clotureeLe : Instant?
  - verrouillee : Boolean
  + ouvrir() : FeuilleNote
  + verrouiller() : FeuilleNote
  + getProgression() : Decimal
  + estComplete() : Boolean
}

class Note {
  - id : UUID
  - evaluation : UUID
  - eleve : UUID
  - valeur : Decimal?
  - statut : StatutNote
  - absent : Boolean
  - exclue : Boolean
  - motifExclusion : String?
  - coefficientReel : Decimal?
  - saisiePar : UUID
  - saisieLe : Instant
  - dateSaisie : Instant
  - apptee : Boolean
  - motifContestation : String?
  - dateContestation : Instant?
  - remplaceePar : UUID?
  + estDefinitive() : Boolean
  + getValeurEffective() : Decimal?
  + exclure(motif : String) : Note
  + contester(motif : String) : Note
  + estAbsente() : Boolean
}

' ============================================================
' CASCADE DE PONDERATION (moteur generique, aucune valeur en dur)
' ============================================================

' La grille elle-meme n est pas redefinie ici :
' elle est propriete de hopital/socle tenant-service.
' Les classes locales ci-dessous en sont la projection
' pedagogique specialisee.

class GrilleNotation <<tenant-service>> #transparent {
  - id : UUID
  - version : Integer
  - annee : UUID
  - profil : String
  - dateActivation : Date
  - configCascade : ConfigCascade
  - regles : List<ReglePonderation>
  + resoudreRegle(candidat : CandidatPonderation) : ReglePonderation
  + getBareme(type : TypeBareme) : Bareme
  + retenir(notes : List<NotePeriodique>) : List<NotePeriodique>
  + getMention(moyenne : Decimal) : Mention
}

class Bareme {
  - type : TypeBareme
  - baremeMax : Decimal
  - noteMinimale : Decimal
  - precision : Integer
  - arrondi : TypeArrondi
  + normaliser(valeur : Decimal) : Decimal
  + convertir(versType : TypeBareme) : Decimal
  + estAtteignable(valeur : Decimal) : Boolean
  + formater(valeur : Decimal) : String
}

class ConfigCascade {
  - niveauxActifs : List<NiveauAcalcul>
  - strategie : StrategieAggregation
  - arrondi : TypeArrondi
  - precision : Integer
  - seuilAbsorption : Decimal?
  - principesEquivalence : List<PrincipeEquivalence>
  + agreger(niveau : NiveauAcalcul, valeurs : List<NotePonderee>) : Decimal
  + normaliser(valeur : Decimal, bareme : Bareme) : Decimal
  + estActif(niveau : NiveauAcalcul) : Boolean
  + verifierEquilibrage(resultat : ResultatCascade) : List<AlerteCascade>
}

class PrincipeEquivalence {
  - type : TypePrincipe
  - cible : String?
  - ponderation : Decimal?
  + appliquer(valeurs : List<NotePonderee>) : List<NotePonderee>
}

enum TypePrincipe {
  MATIERE_EQUIVALENTE
  UE_EQUIVALENTE
  MEILLEUR_GROUPE
  IGNORER_LA_MOYENNE_FAIBLE
  PRENDRE_LA_MEILLEURE
}

class ReglePonderation {
  - libelle : String
  - portee : TypePortee
  - profil : String?
  - cycle : String?
  - niveau : String?
  - parcours : String?
  - programme : String?
  - semestre : String?
  - ue : String?
  - cours : String?
  - matiere : String?
  - enseignant : UUID?
  - classe : UUID?
  - typeEvaluation : String?
  - typeSourceNote : TypeSourceNote?
  - coefficient : Decimal?
  - seuilInclusion : Decimal?
  - plafondContribution : Decimal?
  - poidsMax : Decimal?
  - priorite : Integer
  - active : Boolean
  + sApplique(candidat : CandidatPonderation) : Boolean
  + estPlusSpecifique(autre : ReglePonderation) : Boolean
  + getCoefficient() : Decimal
}

enum TypePortee {
  GLOBALE
  PAR_PROFIL
  PAR_CYCLE
  PAR_NIVEAU
  PAR_PARCOURS
  PAR_PROGRAMME
  PAR_SEMESTRE
  PAR_UE
  PAR_COURS
  PAR_MATIERE
  PAR_ENSEIGNANT
  PAR_CLASSE
  PAR_TYPE_EVALUATION
  PAR_TYPE_SESSION
}

class CandidatPonderation {
  - profil : String
  - cycle : String?
  - niveau : String?
  - parcours : String?
  - programme : String?
  - semestre : String?
  - ue : String?
  - cours : String?
  - matiere : String?
  - enseignant : UUID?
  - classe : UUID?
  - typeEvaluation : String?
  - typeSourceNote : TypeSourceNote?
  - niveauAcalcul : NiveauAcalcul
}

class NotePonderee {
  - eleve : UUID
  - niveau : NiveauAcalcul
  - cible : String
  - libelleCible : String
  - valeur : Decimal
  - coefficient : Decimal
  - poidsNormalise : Decimal?
  - source : TypeSourceNote
  - retenu : Boolean
  - motifExclusion : String?
  - rang : Integer?
  + recalculerPoids(total : Decimal) : NotePonderee
  + estExclu() : Boolean
  + getContribution() : Decimal
}

class MoteurCalculMoyenne {
  + calculer(eleve : UUID, periode : UUID, grille : GrilleNotation,
             notes : List<Note>) : ResultatCascade
  + calculerNiveau(resultat : ResultatCascade, niveau : NiveauAcalcul,
                   grille : GrilleNotation) : List<NotePonderee>
  + verifierRegles(resultat : ResultatCascade,
                   grille : GrilleNotation) : List<AlerteCascade>
}

class ResultatCascade {
  - eleve : UUID
  - periode : UUID
  - classe : UUID
  - grilleVersion : Integer
  - niveaux : List<NiveauAcalcul>
  - calculLe : Instant
  - equilibre : Boolean
  + getMoyenne(niveau : NiveauAcalcul, cible : String) : Decimal?
  + getDetail(niveau : NiveauAcalcul, cible : String) : List<DetailPonderation>
  + getClassement(cible : String) : List<UUID>
  + getTotalPoids() : Decimal
}

class DetailPonderation {
  - evaluation : UUID?
  - sessionExamen : UUID?
  - niveau : NiveauAcalcul
  - libelle : String
  - date : Date
  - valeur : Decimal
  - bareme : TypeBareme
  - coefficient : Decimal
  - poidsNormalise : Decimal
  - retenu : Boolean
  - motifExclusion : String?
  + getExplication() : String
}

class AlerteCascade {
  - code : String
  - message : String
  - niveau : NiveauAcalcul
  - criticite : Criticite
}

enum Criticite {
  BLOQUANT
  AVERTISSEMENT
  INFORMATION
}

class Mention {
  - code : String
  - libelle : String
  - symbole : String
  - seuilMinimum : Decimal
  - couleur : String
  + contient(moyenne : Decimal) : Boolean
}

class Appreciation {
  - libelle : String
  - moyenne : Decimal
  - rang : Integer?
  + getTexte() : String
}

' ============================================================
' AGREGAT : BULLETIN
