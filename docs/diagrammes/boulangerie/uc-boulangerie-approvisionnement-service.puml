@startuml uc-boulangerie-approvisionnement-service
skinparam packageStyle rectangle
skinparam actorStyle stickman
left to right direction

title Diagramme des Cas d'Utilisation - boulangerie-approvisionnement-service (Achats et Receptions)

actor "Magasinier" as MAG
actor "Gerant" as GER
actor "Comptable" as COM
actor "Fournisseur" as FOUR
actor "Systeme Stock" as STK
actor "Systeme Production" as PROD
actor "Systeme Facturation" as FACT
actor "Systeme Notifications" as NOT

rectangle "Plateforme NexusGesti" {
  rectangle "boulangerie-approvisionnement-service" {

    ' ---- Fournisseurs ----
    usecase "Creer un fournisseur" as UC_CreerFourn
    usecase "Modifier un fournisseur" as UC_ModifFourn
    usecase "Evaluer un fournisseur" as UC_EvalFourn

    ' ---- Besoin ----
    usecase "Calculer le besoin d approvisionnement" as UC_Besoin
    usecase "Consulter les articles sous seuil" as UC_SousSeuil

    ' ---- Achat ----
    usecase "Creer une commande d achat" as UC_Commande
    usecase "Valider une commande d achat" as UC_ValiderCommande
    usecase "Envoyer une commande au fournisseur" as UC_Envoyer
    usecase "Annuler une commande d achat" as UC_AnnulerCommande

    ' ---- Reception ----
    usecase "Receptionner une commande" as UC_Reception
    usecase "Controler une reception" as UC_Controler
    usecase "Accepter une reception" as UC_Accepter
    usecase "Refuser une reception" as UC_Refuser
    usecase "Rapprocher facture et reception" as UC_Rapprocher

    ' ---- Relations ----
    UC_Commande .> UC_Besoin : <<include>>
    UC_Commande .> UC_SousSeuil : <<include>>
    UC_ValiderCommande .> UC_Besoin : <<require>>
    UC_Envoyer .> UC_ValiderCommande : <<require>>
    UC_Reception .> UC_Controler : <<include>>
    UC_Accepter .> UC_Controler : <<require>>
    UC_Refuser .> UC_Controler : <<extend>>
    UC_Accepter .> UC_Rapprocher : <<include>>
    UC_Reception .> UC_Commande : <<require>>
    UC_Besoin .> UC_SousSeuil : <<include>>
  }
}

MAG --> UC_Reception
MAG --> UC_Controler
MAG --> UC_SousSeuil
MAG --> UC_Besoin
GER --> UC_CreerFourn
GER --> UC_ModifFourn
GER --> UC_EvalFourn
GER --> UC_Commande
GER --> UC_ValiderCommande
GER --> UC_AnnulerCommande
COM --> UC_Rapprocher
FOUR --> UC_Envoyer
STK --> UC_Reception
STK --> UC_Accepter
PROD --> UC_Besoin
FACT --> UC_Rapprocher
NOT --> UC_SousSeuil
NOT --> UC_Reception

note bottom of UC_Reception
  <b>CONTROLE BLOQUANT</b>
  Quand GrilleStock exige un controle de
  reception, aucune quantite n entre en
  stock avant. Un lot non conforme ne
  cree ni Lot ni MouvementStock : il est
  refuse, jamais integre puis corrige.
end note

note bottom of UC_Rapprocher
  <b>RAPPROCHEMENT TROIS VOIES</b>
  Une facture fournisseur n est reglee
  qu apres concordance :
    commande = reception = facture
  Un ecart de prix genere un litige, pas
  un paiement partiel silencieux.
end note

note bottom of UC_Besoin
  <b>BESOIN CALCULE, PAS SAISI</b>
  Le besoin vient des seuils de
  GrilleStock et du PlanProduction :
  quantite suggeree = seuil + consommation
  prevue - quantite disponible. Aucun
  seuil n est code en dur ici.
end note

note bottom of UC_Accepter
  <b>LOT ET PEREMPTION</b>
  Chaque ligne conforme donne un Lot
  (fin-stock) avec sa date de peremption.
  La rotation FEFO reste appliquee par le
  proprietaire du stock, pas ici.
end note

note bottom of UC_Envoyer
  <b>PAS DE COMMANDE SANS VALIDATION</b>
  Une commande non validee ne peut pas
  etre envoyee au fournisseur : l envoi
  engage l etablissement.
end note

@enduml
