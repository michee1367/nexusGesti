    usecase "Creer une commande" as UC_Commande
    usecase "Valider une commande" as UC_ValiderCommande
    usecase "Recevoir une livraison" as UC_Recevoir
    usecase "Controler la conformite a la reception" as UC_ControlerReception
    usecase "Mettre un lot en quarantaine" as UC_Quarantaine
    usecase "Liberer un lot" as UC_LibererLot
    usecase "Retirer un lot du circuit" as UC_RetirerLot
    usecase "Verifier la date de peremption" as UC_VerifierPeremption
    usecase "Alerter sur seuil bas" as UC_AlerteSeuil

    ' ---- Stock ----
    usecase "Consulter le stock" as UC_ConsulterStock
    usecase "Inventorier" as UC_Inventorier
    usecase "Valider un inventaire" as UC_ValiderInventaire
    usecase "Ajuster le stock" as UC_AjusterStock
    usecase "Enregistrer une perte" as UC_Perte
    usecase "Valoriser le stock" as UC_ValoriserStock
    usecase "Transférer entre emplacements" as UC_Transfert

    ' ---- Dispensation ----
    usecase "Reserver un medicament" as UC_Reserver
    usecase "Preparer une dispensation" as UC_Preparer
    usecase "Verifier la prescription" as UC_VerifierPrescription
    usecase "Verifier les allergies du patient" as UC_VerifierAllergies
    usecase "Verifier le stock" as UC_VerifierStock
    usecase "Dispenser au patient" as UC_Dispenser
    usecase "Signer la remise" as UC_Signer
    usecase "Generer l etiquette" as UC_Etiquette
    usecase "Rejeter une dispensation" as UC_RejeterDispensation
    usecase "Retourner un medicament" as UC_Retour
    usecase "Annuler une dispensation" as UC_AnnulerDispensation

    ' ---- Relations ----
    UC_CreerMedicament .> UC_ConformiteMedicament : <<include>>
    UC_CreerMedicament .> UC_Formes : <<include>>
    UC_CreerMedicament .> UC_Voies : <<include>>
    UC_Recevoir .> UC_ControlerReception : <<include>>
    UC_ControlerReception .> UC_Quarantaine : <<include>>
    UC_LibererLot .> UC_ControlerReception : <<require>>
    UC_RetirerLot .> UC_LibererLot : <<include>>
    UC_VerifierPeremption .> UC_ConsulterStock : <<include>>
    UC_AlerteSeuil .> UC_VerifierPeremption : <<include>>
    UC_Commande .> UC_ValiderCommande : <<include>>
    UC_ValiderCommande .> UC_ConsulterStock : <<require>>
    UC_Inventorier .> UC_AjusterStock : <<include>>
    UC_ValiderInventaire .> UC_AjusterStock : <<include>>
    UC_AjusterStock .> UC_ValoriserStock : <<include>>
    UC_Dispenser .> UC_VerifierPrescription : <<include>>
    UC_Dispenser .> UC_VerifierAllergies : <<include>>
    UC_Dispenser .> UC_VerifierStock : <<include>>
    UC_VerifierPrescription .> UC_Reserver : <<require>>
    UC_Preparer .> UC_Etiquette : <<include>>
    UC_Dispenser .> UC_Signer : <<include>>
    UC_Dispenser .> UC_Preparer : <<require>>
    UC_RejeterDispensation .> UC_VerifierPrescription : <<require>>
    UC_Retour .> UC_Dispenser : <<include>>
    UC_AnnulerDispensation .> UC_Signer : <<extend>>
    UC_VerifierPeremption .> UC_Quarantaine : <<extend>>
    UC_Transfert .> UC_AjusterStock : <<include>>
  }
}

