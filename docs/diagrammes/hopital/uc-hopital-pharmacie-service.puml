    usecase "Verifier la conformite du medicament" as UC_ConformiteMedicament
    usecase "Consulter le referentiel" as UC_ConsulterMedicament
    usecase "Gerer les formes galeniques" as UC_Formes
    usecase "Gerer les voies d administration" as UC_Voies
    usecase "Signaler un produit de rupture" as UC_Rupture
    usecase "Signaler un rappel de lot" as UC_RappelLot

    ' ---- Approvisionnement ----
