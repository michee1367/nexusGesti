@startuml uc-hopital-hospitalisation-service
skinparam packageStyle rectangle
skinparam actorStyle stickman
left to right direction

title Diagramme des Cas d'Utilisation - hopital-hospitalisation-service (Sejour et Lits)

actor "Patient" as PAT
actor "Medecin" as MED
actor "Infirmier" as INF
actor "Medecin-chef de service" as MEDSEC
actor "Administrateur" as ADM
actor "Service demandeur" as SRV
actor "Service Facturation" as FACT
actor "Systeme Comptable" as COM
actor "Systeme Notifications" as NOT

rectangle "Plateforme NexusGesti" {
  rectangle "hopital-hospitalisation-service" {

    ' ---- Service et lits ----
    usecase "Declarer un service" as UC_DeclarerService
    usecase "Definir une chambre" as UC_DefinirChambre
    usecase "Definir un lit" as UC_DefinirLit
    usecase "Mettre un lit hors service" as UC_LitHorsService
    usecase "Rendre un lit disponible" as UC_LitDisponible
    usecase "Bloquer un type d admission" as UC_BlocAdmission
    usecase "Consulter le taux d occupation" as UC_TauxOccupation

    ' ---- Decision d hospitalisation ----
    usecase "Decider une hospitalisation" as UC_DeciderHospitalisation
    usecase "Verifier un lit disponible" as UC_VerifierLit
    usecase "Verifier la compatibilite du lit" as UC_Compatibilite
    usecase "Programmer la sortie" as UC_ProgrammerSortie

    ' ---- Admission ----
    usecase "Enregistrer une admission" as UC_Admettre
    usecase "Renseigner le motif d admission" as UC_MotifAdmission
    usecase "Declarer une allergie" as UC_Allergie
    usecase "Obtenir le consentement de soins" as UC_Consentement
    usecase "Afficher le bon d admission" as UC_BonAdmission

    ' ---- Pendant le sejour ----
    usecase "Affecter un lit" as UC_AffecterLit
    usecase "Changer de lit" as UC_ChangerLit
    usecase "Transfert interne entre services" as UC_TransfertInterne
    usecase "Permutation entre chambres" as UC_Permutation
    usecase "Escalade de soins" as UC_Escalade
    usecase "Transfert pour soins non prevus" as UC_SoinsNonPrevus
    usecase "Consulter le sejour" as UC_ConsulterSejour
    usecase "Consulter la duree de sejour" as UC_DureeSejour

    ' ---- Sortie et cloture ----
    usecase "Enregistrer la sortie" as UC_EnregistrerSortie
    usecase "Autoriser la sortie" as UC_AutoriserSortie
    usecase "Refuser la sortie" as UC_RefuserSortie
    usecase "Organiser un transfert externe" as UC_TransfertExterne
    usecase "Enregistrer un deces" as UC_Deces
    usecase "Sortie contre avis" as UC_SortieContreAvis
    usecase "Rediger le compte rendu" as UC_CompteRendu
    usecase "Signer le compte rendu" as UC_SignerCR
    usecase "Editer l ordonnance de sortie" as UC_OrdonnanceSortie
    usecase "Cloturer le sejour" as UC_Cloturer

    ' ---- Valorisation et facturation ----
    usecase "Valoriser le sejour" as UC_Valoriser
    usecase "Figer la grille tarifaire" as UC_FigerGrille
    usecase "Emettre l acte facturable" as UC_EmettreActe
    usecase "Suspendre la facturation" as UC_SuspendreFacturation

    ' ---- Relations ----
    UC_DeciderHospitalisation .> UC_VerifierLit : <<include>>
    UC_VerifierLit .> UC_Compatibilite : <<include>>
    UC_Admettre .> UC_MotifAdmission : <<include>>
    UC_Admettre .> UC_AffecterLit : <<include>>
    UC_Admettre .> UC_Consentement : <<include>>
    UC_AffecterLit .> UC_VerifierLit : <<include>>
    UC_EnregistrerSortie .> UC_AutoriserSortie : <<include>>
    UC_AutoriserSortie .> UC_CompteRendu : <<include>>
    UC_CompteRendu .> UC_SignerCR : <<include>>
    UC_Cloturer .> UC_CompteRendu : <<include>>
    UC_Cloturer .> UC_Valoriser : <<include>>
    UC_Valoriser .> UC_EmettreActe : <<include>>
    UC_EmettreActe .> UC_FigerGrille : <<include>>
    UC_Valoriser .> UC_SuspendreFacturation : <<extend>>
    UC_TransfertInterne .> UC_AffecterLit : <<include>>
    UC_SoinsNonPrevus .> UC_TransfertInterne : <<extend>>
    UC_Deces .> UC_EnregistrerSortie : <<extend>>
    UC_SortieContreAvis .> UC_EnregistrerSortie : <<extend>>
    UC_DeciderHospitalisation .> UC_ProgrammerSortie : <<extend>>
    UC_TauxOccupation .> UC_DefinirLit : <<extend>>
  }
}

MED --> UC_DeciderHospitalisation
