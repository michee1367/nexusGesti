    usecase "Generer le fichier FEC" as UC_FEC
    usecase "Generer la liste des dossiers comptables" as UC_ListDossiers
    usecase "Certifier un etat" as UC_Certifier
    usecase "Verrouiller un etat" as UC_Verrouiller
