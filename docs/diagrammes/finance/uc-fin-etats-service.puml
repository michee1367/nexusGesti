    UC_VerifierTVA .> UC_Anomalie : <<extend>>
    UC_VerifierDevise .> UC_Anomalie : <<extend>>
    UC_VerifierPiece .> UC_Anomalie : <<extend>>
    UC_ValiderEcriture .> UC_VerifierEquilibre : <<require>>
    UC_ValiderEcriture .> UC_VerifierPiece : <<require>>
    UC_Comptabiliser .> UC_ValiderEcriture : <<require>>
    UC_RefuserEcriture .> UC_Anomalie : <<include>>
    UC_RegulariserEcriture .> UC_ValiderEcriture : <<include>>
    UC_EcriturePeriodique .> UC_EcritureRecurrente : <<extend>>
    UC_LettrageAuto .> UC_LettrerEcriture : <<include>>
    UC_CompteCourant .> UC_LettrerEcriture : <<include>>
    UC_Journalier .> UC_JournalGeneral : <<include>>
    UC_GrandLivre .> UC_JournalGeneral : <<require>>
    UC_Balance .> UC_GrandLivre : <<require>>
    UC_BalanceAuxiliaire .> UC_Balance : <<require>>
    UC_BalanceAgee .> UC_BalanceAuxiliaire : <<require>>
    UC_Bilan .> UC_Balance : <<require>>
    UC_CompteResultat .> UC_Balance : <<require>>
    UC_TableauFinancement .> UC_Bilan : <<require>>
    UC_EtatTresorerie .> UC_Journalier : <<require>>
    UC_ChargesNature .> UC_CompteResultat : <<require>>
    UC_FEC .> UC_GrandLivre : <<require>>
    UC_ListDossiers .> UC_FEC : <<include>>
    UC_Certifier .> UC_ConsulterEtat : <<require>>
    UC_Verrouiller .> UC_Certifier : <<include>>
  }
