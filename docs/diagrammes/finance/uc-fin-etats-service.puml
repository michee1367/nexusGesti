    usecase "Editer un journalier" as UC_Journalier
    usecase "Editer le grand livre" as UC_GrandLivre
    usecase "Editer la balance" as UC_Balance
    usecase "Editer la balance auxiliaire" as UC_BalanceAuxiliaire
    usecase "Editer la balance agee" as UC_BalanceAgee
