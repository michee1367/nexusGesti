    usecase "Saisir une operation diverse" as UC_OD
    usecase "Previsualiser une ecriture" as UC_Previsualiser
    usecase "Enregistrer une piece justificative" as UC_Piece
    usecase "Valider une ecriture" as UC_ValiderEcriture
    usecase "Comptabiliser une ecriture" as UC_Comptabiliser
    usecase "Refuser une ecriture" as UC_RefuserEcriture
